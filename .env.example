# Copy to .env (never commit .env). Everything is optional: with no settings the
# service runs the free demo extractor and stores data under ./var.

# true = stateless demo routes (what the public Vercel deployment uses; Vercel sets VERCEL=1)
DEMO_MODE=false

# --- the model -----------------------------------------------------------------
# The one-step switch: a free Groq key (console.groq.com). With it, the real model
# reads invoices; without it, the free demo extractor does.
GROQ_API_KEY=
# Or any OpenAI-compatible provider (LLM_API_KEY wins over GROQ_API_KEY):
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1
# json_schema (default) or function_calling, if your provider lacks JSON-schema mode
LLM_STRUCTURED_METHOD=json_schema
# demo forces the free extractor even when a key is set
EXTRACTOR=
# Seconds per model call and HTTP retries inside one call (defaults: 12 / 0 on Vercel, 30 / 2 elsewhere)
LLM_TIMEOUT_S=
LLM_MAX_RETRIES=

# Check invoice dates as of this day instead of today (the demo uses 2026-11-13 for
# the samples and today for uploads unless this is set)
AS_OF_DATE=

# SQLite files for the full service (the MCP server uses the same ones)
DB_PATH=var/invoices.db
CHECKPOINT_PATH=var/checkpoints.db

# --- limits, OCR, logs, tracing --------------------------------------------------
DEMO_RUNS_PER_HOUR=60
VENDOR_ADDS_PER_HOUR=30
# true = run pytesseract on uploaded images on the server (local use; needs the Tesseract binary).
# The demo page OCRs photos in the browser instead.
SERVER_OCR=false
# json (default) or text
LOG_FORMAT=json
# LangSmith tracing, off by default: a trace sends the invoice text to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
